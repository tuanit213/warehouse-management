      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "{{job}} p95",
          "refId": "A"
        }
      ],
      "title": "P95 Latency",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "wms-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
