NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-chars
INTERNAL_GATEWAY_TOKEN=replace-with-a-long-random-internal-gateway-token
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@your-company.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-admin-password
BOOTSTRAP_ADMIN_NAME=Production Admin
SMOKE_ADMIN_EMAIL=smoke@your-company.com
SMOKE_ADMIN_PASSWORD=replace-with-current-admin-password-for-smoke-tests
# Or set SMOKE_ADMIN_ACCESS_TOKEN instead of SMOKE_ADMIN_EMAIL/SMOKE_ADMIN_PASSWORD when running smoke tests.
CORS_ORIGIN=https://wms.example.com
PUBLIC_FRONTEND_HOST=wms.example.com
PUBLIC_API_HOST=api.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443
PROXY_TIMEOUT_MS=10000
AUTH_VERIFY_TIMEOUT_MS=3000

# POSTGRES_USER is used as an unquoted PostgreSQL role identifier: letters, numbers, and underscores only;
# it must start with a letter or underscore and be at most 63 characters.
# POSTGRES_PASSWORD is embedded in DATABASE_URL by compose; use URL-safe unreserved characters only:
# letters, numbers, dot, underscore, tilde, hyphen.
POSTGRES_USER=wms_prod
POSTGRES_PASSWORD=replace-with-strong-db-password

AUTH_DB=auth_db
PRODUCT_DB=product_db
INVENTORY_DB=inventory_db
TRANSACTION_DB=transaction_db
REPORT_DB=report_db

# RabbitMQ credentials are embedded in amqp:// URLs by compose.
# Use URL-safe unreserved characters only: letters, numbers, dot, underscore, tilde, hyphen.
RABBITMQ_DEFAULT_USER=wms_rabbit
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
REDIS_URL=redis://redis:6379
PRODUCT_UPLOAD_DIR=/app/uploads/products
PRODUCT_IMAGE_MAX_BYTES=2097152
PRODUCT_PUBLIC_BASE_URL=https://api.example.com/api

TRANSACTION_OUTBOX_PUBLISHER_ENABLED=true
TRANSACTION_OUTBOX_EXCHANGE=wms.transaction.events
TRANSACTION_OUTBOX_DEAD_EXCHANGE=wms.transaction.events.dead
TRANSACTION_OUTBOX_DEAD_QUEUE=wms.transaction.events.dead
TRANSACTION_OUTBOX_POLL_MS=2000
TRANSACTION_OUTBOX_BATCH_SIZE=25
TRANSACTION_OUTBOX_MAX_ATTEMPTS=10
TRANSACTION_OUTBOX_STALE_MINUTES=5
INVENTORY_TRANSACTION_CONSUMER_ENABLED=true
INVENTORY_TRANSACTION_EVENTS_QUEUE=wms.inventory.transaction-events
INVENTORY_TRANSACTION_DEAD_EXCHANGE=wms.inventory.transaction-events.dead
INVENTORY_TRANSACTION_DEAD_QUEUE=wms.inventory.transaction-events.dead
INVENTORY_TRANSACTION_CONSUMER_PREFETCH=10

NEXT_PUBLIC_API_URL=https://api.example.com/api
FRONTEND_PORT=3006

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3008
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
LOKI_PORT=3100
OBSERVABILITY_BIND_HOST=127.0.0.1
# Set OBSERVABILITY_EXPOSE_PUBLIC=true only if Prometheus/Grafana/Loki are protected by firewall or proxy auth.
OBSERVABILITY_EXPOSE_PUBLIC=false
