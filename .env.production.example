NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-production-secret-at-least-32-chars
INTERNAL_GATEWAY_TOKEN=replace-with-a-long-random-internal-gateway-token
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@wms.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-bootstrap-admin-password
BOOTSTRAP_ADMIN_NAME=Production Admin
CORS_ORIGIN=http://localhost:3006
PROXY_TIMEOUT_MS=10000
AUTH_VERIFY_TIMEOUT_MS=3000

POSTGRES_USER=wms_prod
POSTGRES_PASSWORD=replace-with-strong-db-password

AUTH_DB=auth_db
PRODUCT_DB=product_db
INVENTORY_DB=inventory_db
TRANSACTION_DB=transaction_db
REPORT_DB=report_db

RABBITMQ_DEFAULT_USER=wms_rabbit
RABBITMQ_DEFAULT_PASS=replace-with-strong-rabbitmq-password
REDIS_URL=redis://redis:6379
PRODUCT_UPLOAD_DIR=/app/uploads/products
PRODUCT_IMAGE_MAX_BYTES=2097152
PRODUCT_PUBLIC_BASE_URL=http://localhost:3000/api

TRANSACTION_OUTBOX_PUBLISHER_ENABLED=true
TRANSACTION_OUTBOX_EXCHANGE=wms.transaction.events
TRANSACTION_OUTBOX_DEAD_EXCHANGE=wms.transaction.events.dead
TRANSACTION_OUTBOX_DEAD_QUEUE=wms.transaction.events.dead
TRANSACTION_OUTBOX_POLL_MS=2000
TRANSACTION_OUTBOX_BATCH_SIZE=25
TRANSACTION_OUTBOX_MAX_ATTEMPTS=10
TRANSACTION_OUTBOX_STALE_MINUTES=5
INVENTORY_TRANSACTION_CONSUMER_ENABLED=true
INVENTORY_TRANSACTION_EVENTS_QUEUE=wms.inventory.transaction-events
INVENTORY_TRANSACTION_DEAD_EXCHANGE=wms.inventory.transaction-events.dead
INVENTORY_TRANSACTION_DEAD_QUEUE=wms.inventory.transaction-events.dead
INVENTORY_TRANSACTION_CONSUMER_PREFETCH=10

NEXT_PUBLIC_API_URL=http://localhost:3000/api
FRONTEND_PORT=3006

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3008
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
LOKI_PORT=3100
