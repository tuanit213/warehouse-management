{
  "name": "warehouse-management-system",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=200",
    "check": "docker compose config",
    "seed:demo": "node scripts/seed-demo-data.js",
    "smoke:test": "node scripts/smoke-test.js",
    "health:check": "node scripts/health-check.js",
    "test:rbac": "node scripts/rbac-regression-test.js",
    "test:inventory": "node scripts/inventory-regression-test.js",
    "test:transactions": "node scripts/transaction-regression-test.js",
    "test:auth": "node scripts/auth-regression-test.js",
    "test:migrations": "node scripts/migration-regression-test.js",
    "test:auth-critical": "node scripts/auth-critical-test.js",
    "test:inventory-concurrency": "node scripts/inventory-concurrency-test.js",
    "test:transaction-idempotency": "node scripts/transaction-idempotency-test.js",
    "test:migration-idempotency": "node scripts/migration-idempotency-test.js",
    "test:critical": "npm run test:auth-critical && npm run test:inventory-concurrency && npm run test:transaction-idempotency && npm run test:migration-idempotency",
    "test:quality": "node scripts/static-quality-check.js",
    "test:regression": "npm run test:quality && npm run test:rbac && npm run test:auth && npm run test:inventory && npm run test:transactions && npm run test:migrations",
    "migrate": "node scripts/migrate.js",
    "migrate:dry-run": "node scripts/migrate.js --dry-run",
    "migrate:auth": "node scripts/migrate.js --service auth",
    "migrate:inventory": "node scripts/migrate.js --service inventory",
    "migrate:transaction": "node scripts/migrate.js --service transaction",
    "migrate:all": "node scripts/migrate.js --service all",
    "migrate:preflight": "node scripts/migrate.js --preflight --service all",
    "migrate:preflight:auth": "node scripts/migrate.js --preflight --service auth",
    "migrate:preflight:inventory": "node scripts/migrate.js --preflight --service inventory",
    "migrate:preflight:transaction": "node scripts/migrate.js --preflight --service transaction",
    "prod:env:check": "node scripts/validate-production-env.js",
    "prod:config": "docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml config",
    "prod:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-production.ps1",
    "prod:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-production.ps1",
    "demo:ready": "npm run compose:up && npm run seed:demo && npm run smoke:test"
  },
  "workspaces": [
    "frontend",
    "services/*"
  ],
  "overrides": {
    "postcss": "8.5.10",
    "next": {
      "postcss": "8.5.10"
    }
  }
}
