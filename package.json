    "seed:demo": "node scripts/seed-demo-data.js",
    "smoke:test": "node scripts/smoke-test.js",
    "demo:ready": "npm run compose:up && npm run seed:demo && npm run smoke:test"
  },
  "workspaces": [
    "frontend",
    "services/*"
  ]
}